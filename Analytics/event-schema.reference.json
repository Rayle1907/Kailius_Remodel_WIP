  "parameter_definitions": [
    {
      "name": "schema_version",
      "type": "integer",
      "description": "Version of the client research telemetry parameter format. The current revised format is version 2."
    },
    {
      "name": "event_sequence",
      "type": "integer",
      "description": "Increasing research event creation order within the application runtime; resets when the runtime initializes."
    },
    {
      "name": "attempt_id",
      "type": "string",
      "description": "Identifier linking an attempt start and end with related death, failure, and revive events."
    },
    {
      "name": "level_segment_id",
      "type": "string",
      "description": "Identifier of the current level or tracked segment. In attempt events, it is the baked segment definition ID used for geometry catalogue matching."
    },
    {
      "name": "segment_version",
      "type": "string",
      "description": "Version of the segment definition used for this attempt."
    },
    {
      "name": "geometry_hash",
      "type": "string",
      "description": "Fingerprint identifying the baked geometry associated with this attempt."
    },
    {
      "name": "start_reason",
      "type": "string",
      "description": "Reason this segment attempt began."
    },
    {
      "name": "attempt_number",
      "type": "integer",
      "description": "Recorded exposure count for this segment and segment version."
    },
    {
      "name": "health",
      "type": "integer",
      "description": "Player health recorded at the beginning of the attempt."
    },
    {
      "name": "defense",
      "type": "integer",
      "description": "Player defense recorded at the beginning of the attempt."
    },
    {
      "name": "attack_damage",
      "type": "integer",
      "description": "Player attack damage recorded at the beginning of the attempt."
    },
    {
      "name": "move_speed",
      "type": "float",
      "description": "Player movement speed recorded at the beginning of the attempt."
    },
    {
      "name": "jump_height",
      "type": "float",
      "description": "Player jump-height setting recorded at the beginning of the attempt."
    },
    {
      "name": "gravity",
      "type": "float",
      "description": "Player gravity setting recorded at the beginning of the attempt."
    },
    {
      "name": "wall_distance",
      "type": "float",
      "description": "Wall-distance measurement recorded at the beginning of the attempt."
    },
    {
      "name": "wall_active",
      "type": "boolean",
      "description": "Whether the tracked wall is active at the beginning of the attempt."
    },
    {
      "name": "outcome",
      "type": "string",
      "description": "Segment attempt result: success, failure, or unresolved."
    },
    {
      "name": "reason",
      "type": "string",
      "description": "Recorded reason the segment attempt ended."
    },
    {
      "name": "duration_seconds",
      "type": "float",
      "description": "Elapsed seconds from the beginning to the end of this attempt."
    },
    {
      "name": "progress_x",
      "type": "float",
      "description": "Player world-space X position when the attempt ended."
    },
    {
      "name": "progress_y",
      "type": "float",
      "description": "Player world-space Y position when the attempt ended."
    },
    {
      "name": "time_since_session_start",
      "type": "float",
      "description": "Seconds elapsed on the existing analytics bootstrap session clock."
    },
    {
      "name": "playthrough_id",
      "type": "string",
      "description": "Identifier linking events belonging to the same playthrough."
    },
    {
      "name": "run_id",
      "type": "string",
      "description": "Identifier linking events belonging to the same gauntlet run."
    },
    {
      "name": "gauntlet_session_id",
      "type": "string",
      "description": "Identifier linking events belonging to the same gauntlet gameplay session."
    },
    {
      "name": "scene_name",
      "type": "string",
      "description": "Name of the scene associated with the event."
    },
    {
      "name": "offer_variant",
      "type": "string",
      "description": "Revive experiment variant assigned to the player."
    },
    {
      "name": "experiment_version",
      "type": "string",
      "description": "Version of the revive experiment configuration."
    },
    {
      "name": "defeated_required_enemies",
      "type": "integer",
      "description": "Number of required enemies defeated at the recorded observation."
    },
    {
      "name": "total_required_enemies",
      "type": "integer",
      "description": "Total number of required enemies at the recorded observation."
    }
  ]
}
